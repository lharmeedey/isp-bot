# ─────────────────────────────────────────────────────────────
# ISP Voucher Bot — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
# Postgres connection string.
DATABASE_URL=postgres://user:password@host:5432/dbname

# HTTP port the master Express app listens on (Render sets this automatically).
PORT=3000

# "production" enables prod behaviour: SSL on Postgres, ENCRYPTION_KEY required,
# leaner logging. Leave unset (or "development") locally.
NODE_ENV=production

# Public base URL of this deployment, used to register Telegram + payment
# webhooks, e.g. https://your-app.onrender.com  (no trailing slash).
WEBHOOK_URL=https://your-app.onrender.com

# ── Secret encryption (REQUIRED in production) ────────────────
# 32-byte key as 64 hex chars. Encrypts every tenant secret at rest
# (bot tokens, Paystack keys, Omada/MikroTik creds).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Set ONLY during a key rotation — the previous ENCRYPTION_KEY, so old data can
# still be decrypted while `npm run rotate` re-encrypts it. Remove afterwards.
# OLD_ENCRYPTION_KEY=

# ── Super admin ───────────────────────────────────────────────
# Comma-separated Telegram user IDs allowed to run tenant-management commands.
SUPER_ADMIN_IDS=111111111,222222222
# Legacy alias still read by adminGuard.js — keep in sync with SUPER_ADMIN_IDS.
ADMIN_IDS=111111111,222222222

# ── Single-tenant / legacy fallbacks ──────────────────────────
# Most config now lives per-tenant in the database. These are only used as a
# fallback for a single default bot / global plans. Leave blank in multi-tenant
# deployments.
BOT_TOKEN=
PAYSTACK_SECRET=
PAYSTACK_CALLBACK_URL=
# Global plans JSON array, used only when a tenant has no tenant_plans rows.
# Each item: {"label","price","gb","validity","omadaProfileId"}
PLANS=[]

# ── Monnify (optional alternate payment provider) ─────────────
MONNIFY_API_KEY=
MONNIFY_SECRET=
MONNIFY_CONTRACT_CODE=
MONNIFY_REDIRECT_URL=
